{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clautana",
  "version": "0.1.0",
  "identifier": "com.brend.clautana",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node src-tauri/scripts/stage-sdk.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clautana",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/clautana-runtime"],
    "resources": {
      "resources/claude-agent-sdk/": "node_modules/@anthropic-ai/claude-agent-sdk/"
    }
  }
}
